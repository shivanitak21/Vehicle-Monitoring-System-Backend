NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Local Docker Mongo or a MongoDB Atlas URI. Replace this in production.
MONGODB_URI=mongodb://127.0.0.1:27017/vehicle_safety

# Development-only secret. Use a unique 32+ character value in production.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32b
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=vehicle-safety

# Comma-separated browser origins. Native apps omit Origin and are still allowed.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
TRUST_PROXY=false
BODY_LIMIT=256kb

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_DISABLED=false

LOCATION_STALE_AFTER_SECONDS=45
DEVICE_OFFLINE_AFTER_SECONDS=90
LOCATION_MAX_FUTURE_SKEW_SECONDS=30
LOCATION_MAX_AGE_SECONDS=180
LOCATION_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=30
MOVING_SPEED_KPH=3

HIGH_RISK_THRESHOLD=40
SAFETY_WINDOW_MINUTES=30
RISK_RULES_VERSION=2026.1

# Development broker is plain MQTT. Production must use mqtts:// and a unique password.
MQTT_ENABLED=true
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=dev-backend-mqtt-password
MQTT_CLIENT_ID=vehicle-safety-backend
MQTT_REJECT_UNAUTHORIZED=true

# Simulator and demo-tagged records. Must be false in production.
DEMO_ENABLED=true
DEMO_DEVICE_INGEST_KEY=dev-device-ingest-key-change-me
MQTT_DEVICE_USERNAME=demo-device
MQTT_DEVICE_PASSWORD=dev-device-mqtt-password

# Leave blank until Expo push is configured. Unset means notifications stay unavailable or simulated.
EXPO_PUSH_ACCESS_TOKEN=

# Leave blank until S3-compatible storage is configured.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
MEDIA_URL_TTL_SECONDS=300
MEDIA_UPLOAD_MAX_BYTES=52428800

# Optional providers. Empty means no inference is performed.
VISION_PROVIDER_URL=
VISION_PROVIDER_TOKEN=
VISION_PROVIDER_TIMEOUT_MS=4000
SPEECH_PROVIDER_URL=

# Development seed accounts. Replace before any shared environment.
SEED_GUARDIAN_EMAIL=guardian@example.com
SEED_GUARDIAN_PASSWORD=DevOnly-ChangeMe-12345
SEED_GUARDIAN_NAME=Dev Guardian
SEED_PASSENGER_EMAIL=passenger@example.com
SEED_PASSENGER_PASSWORD=DevOnly-ChangeMe-12345
SEED_PASSENGER_NAME=Dev Passenger
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=DevOnly-ChangeMe-12345
SEED_ADMIN_NAME=Dev Administrator
